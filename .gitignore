# Ignore everything under data (runtime/state) by default
data/**

# Allow traversing directories so we can selectively unignore YAML
!data/**/

# Unignore all YAML/YML config & blueprints
!data/**/*.yaml
!data/**/*.yml


.env

# Editor / OS files
*.swp
.DS_Store

noip.conf

# Python virtual environment
venv/


# Home Assistant runtime state that happens to be YAML (banned client IPs)
data/homeassistant/ip_bans.yaml

# Python tools that HA runs (shell_command) and their tests
!data/homeassistant/tools/*.py
