# Global: HTTP/3 off. UDP 443 belongs to the snekgame WebTransport server,
# so advertising h3 would send browsers' page loads to the wrong endpoint.
{
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	root * /srv/www
	file_server
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}
}

# Redirect www to the bare apex
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

christmas.{$DOMAIN} {
	root * /srv/christmas-party
	file_server
	encode gzip
}

hass.{$DOMAIN} {
	encode gzip

	reverse_proxy homeassistant:8123 {
		transport http {
			compression off
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
	}

	redir /.well-known/carddav /remote.php/dav 308
	redir /.well-known/caldav /remote.php/dav 308
}

