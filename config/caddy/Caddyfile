# Global: HTTP/3 off (UDP 443 was the snekgame WebTransport server's; snek,
# the blog, www and ppp now live on the schlift.com VM).
#
# Certificates come from Let's Encrypt over Cloudflare DNS (DNS-01) for every
# site, so nothing needs ports 80/443 open to the internet.
{
	servers {
		protocols h1 h2
	}
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

christmas.{$DOMAIN} {
	root * /srv/christmas-party
	file_server
	encode gzip
}

hass.{$DOMAIN} {
	encode gzip

	reverse_proxy homeassistant:8123 {
		transport http {
			compression off
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
	}

	redir /.well-known/carddav /remote.php/dav 308
	redir /.well-known/caldav /remote.php/dav 308
}

# Schniffer's monitor dashboard (the /schniff dashboard command mints its links).
# Home network and WireGuard only (192.168.10.0/24 is the UniFi VPN): the public
# schniffmap is a static site on the schlift.com VM, so nothing from the
# internet reaches the bot.
monitor.{$DOMAIN} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			dns cloudflare {env.CLOUDFLARE_API_TOKEN}
			resolvers 1.1.1.1 8.8.8.8
		}
	}

	@lan remote_ip 192.168.1.0/24 192.168.10.0/24 127.0.0.1 ::1
	handle @lan {
		reverse_proxy schniffer-bot:8069 {
			transport http {
				compression off
			}
		}
	}
	handle {
		respond "Local network access only" 403
	}
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
}

herdcore.{$DOMAIN} {
	encode gzip

	reverse_proxy host.docker.internal:8090 {
		transport http {
			compression off
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
	}
}

# The house shortlist (~/houses, its own repository and container). It is reached over houses_edge, a docker
# network only Caddy and it share, so it is published on no public or LAN interface at all and this block is the single way in. The
# app does its own login, so no credentials live in this repository, and it holds no financial data of any
# kind -- which is the whole reason it was moved out of the finance site.
house.{$DOMAIN} {
	encode gzip

	# Who tried to get in, and from where: the app sees only Caddy's address.
	log {
		output file /data/logs/house.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	reverse_proxy houses:8096 {
		transport http {
			compression off
		}
		header_down -Server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# A private shortlist has no business in a search index.
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
}

# Router management is home network and WireGuard only. DNS-01 needs no public router address or login.
router.{$DOMAIN} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            dns cloudflare {env.CLOUDFLARE_API_TOKEN}
            resolvers 1.1.1.1 8.8.8.8
        }
    }

    @lan remote_ip 192.168.1.0/24 192.168.10.0/24 127.0.0.1 ::1
    handle @lan {
        reverse_proxy https://192.168.1.1 {
            header_up Host {http.request.host}
            transport http {
                # UniFi's upstream certificate is self-signed; the browser sees Let's Encrypt.
                tls_insecure_skip_verify
            }
        }
    }
    handle {
        respond "Local network access only" 403
    }
    header X-Robots-Tag "noindex, nofollow, noarchive"
}

# Only so Caddy keeps a certificate for the Google relay (config/google-relay): the relay terminates TLS for this
# name with Caddy's certificate files, mounted read-only. The name points at the schlift.com VM, never here, so
# nothing should arrive; anything that does is dropped.
hass-google.{$DOMAIN} {
	abort
}
