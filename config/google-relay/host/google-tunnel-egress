#!/bin/sh
# The google-tunnel container's own network (bridge br-google-egr) may reach one thing: the VM's SSH port. Not the
# LAN, the router, other containers' published ports, or anywhere else on the internet. (Replies to its SSH
# connection come in on the other direction, which this doesn't touch.) Installed as /usr/local/sbin/ and run by
# google-tunnel-egress.service whenever Docker starts.
set -eu
VM=146.235.203.8
BR=br-google-egr
iptables -N GOOGLE-TUNNEL-EGRESS 2>/dev/null || iptables -F GOOGLE-TUNNEL-EGRESS
iptables -A GOOGLE-TUNNEL-EGRESS -p tcp -d "$VM" --dport 22 -j RETURN
iptables -A GOOGLE-TUNNEL-EGRESS -j DROP
iptables -C DOCKER-USER -i "$BR" -j GOOGLE-TUNNEL-EGRESS 2>/dev/null || iptables -I DOCKER-USER -i "$BR" -j GOOGLE-TUNNEL-EGRESS
